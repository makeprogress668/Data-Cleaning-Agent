# Optional LLM configuration for the goal-understanding layer.
# Keep secrets out of source control. Copy to `.env` and fill in.
#
# When these are unset, the agent runs fully on the deterministic engine.
# When set, an LLM drafts the plan and the deterministic engine validates and
# executes it (the LLM never mutates data directly).

# Required to enable the LLM layer (OpenAI or any OpenAI-compatible gateway).
DATA_AGENT_LLM_API_KEY=

# OpenAI-compatible base URL (defaults to https://api.openai.com/v1).
# For internal gateways, point this at your proxy, e.g. https://llm-gw.internal/v1
DATA_AGENT_LLM_BASE_URL=

# Model name served by the endpoint (defaults to gpt-4o-mini).
DATA_AGENT_LLM_MODEL=

# Optional tuning.
# DATA_AGENT_LLM_TIMEOUT=30
# DATA_AGENT_LLM_MAX_RETRIES=2
# DATA_AGENT_LLM_TEMPERATURE=0
# DATA_AGENT_LLM_ORG=

# Deep-thinking switch for reasoning models (e.g. Volcengine Ark Doubao Seed).
# Such models run a chain-of-thought by default, which makes one understanding
# call take tens of seconds. This task only needs structured extraction, so set
# "disabled" to return in ~1s. Leave unset for plain OpenAI-compatible endpoints.
# DATA_AGENT_LLM_THINKING=disabled

# Data context exposed to the LLM:
# - metadata_only: schema/statistics only, never cell values
# - masked_samples: small samples with identifier/sensitive fields masked (default)
# - trusted_samples: small raw samples for private deployments or explicit consent
# DATA_AGENT_LLM_DATA_ACCESS_MODE=masked_samples

# Set to 0/false to force the deterministic path even if a key is present.
# DATA_AGENT_LLM_ENABLED=1

# --- Optional: bounded post-execution reflection (phase two) ---
# After a job runs, if the quality score is below the target, let the LLM propose
# one small, validated JobConfig change and re-run, keeping the better result.
# Requires the LLM layer above. A no-op without an LLM key.
# DATA_AGENT_REFLECTION_ENABLED=1
# DATA_AGENT_REFLECTION_MAX_ROUNDS=1
# DATA_AGENT_REFLECTION_TARGET_SCORE=90

# --- Optional: lightweight long-term memory (phase three) ---
# Remembers stable, schema-level preferences (frequent base tables / critical
# fields / match modes) across tasks and feeds a soft hint back into planning.
# Off by default. Only field/table names and counts are stored, never raw data.
# DATA_AGENT_MEMORY_ENABLED=0
# DATA_AGENT_MEMORY_PATH=data/user_memory.json

# --- Understanding reuse ---
# The same semantic profile plus the same sentence reuse the previous understanding,
# scoped by tenant and keyed on goal + column semantics + prompt/model/access policy.
#
# ON by default — reproducibility is the point. Turn it off while iterating on prompts,
# where you want every run to ask the model again. A cached reading is also a *stuck*
# reading: if one goal is understood wrongly, clear it with
# `data-agent understanding-cache --clear` rather than waiting for it to expire.
# DATA_AGENT_UNDERSTANDING_CACHE=1
# Local development uses a file. Production compose overrides this with postgres so
# every worker reuses the same understanding without a shared filesystem.
# DATA_AGENT_UNDERSTANDING_CACHE_BACKEND=file
# DATA_AGENT_UNDERSTANDING_CACHE_PATH=data/understanding_cache.json
# DATA_AGENT_UNDERSTANDING_CACHE_TTL_SECONDS=2592000
# Default tenant for local or legacy single-key deployments.
# DATA_AGENT_TENANT_ID=default

# ============================================================================
# Production API runtime (used by the Docker/compose deployment)
# ============================================================================

# Docker Compose sets production mode. In production the API fails closed unless
# a strong key is configured; local development remains open by default.
# DATA_AGENT_ENV=production
DATA_AGENT_API_KEY=replace-with-a-long-random-secret

# Multi-tenant API-key map. When set, this replaces DATA_AGENT_API_KEY for API
# authentication. Values may be a key string (admin role) or an object with
# api_key + role (viewer/operator/admin). API keys must be unique.
# DATA_AGENT_TENANT_API_KEYS_JSON={"acme":{"api_key":"replace-me","role":"admin"}}

# OIDC/JWT end-user authentication. Configure this instead of API keys when users
# sign in through an identity provider. The tenant and role claims are mandatory by
# default; accepted roles are viewer/operator/admin. JWKS keys are cached and all
# tokens must pass signature, issuer, audience, expiry and subject validation.
# DATA_AGENT_OIDC_ISSUER=https://id.example.com/
# DATA_AGENT_OIDC_AUDIENCE=data-agent
# DATA_AGENT_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
# DATA_AGENT_OIDC_ALGORITHMS=RS256
# DATA_AGENT_OIDC_TENANT_CLAIM=tenant_id
# DATA_AGENT_OIDC_ROLE_CLAIM=role
# DATA_AGENT_OIDC_DEFAULT_ROLE=viewer
# DATA_AGENT_OIDC_LEEWAY_SECONDS=30

# Comma-separated allowed CORS origins. Defaults to "*" (any origin). In
# production set this to your console origin(s), e.g. https://data-agent.example.com
# DATA_AGENT_CORS_ORIGINS=*

# Per-IP request rate limit (requests per 60s sliding window). <=0 disables it.
# DATA_AGENT_RATE_LIMIT_PER_MINUTE=600

# Background job executor thread pool size per worker process.
# DATA_AGENT_API_MAX_WORKERS=2

# Async execution backend. Local development defaults to the in-process thread pool.
# Production compose uses ARQ; ARQ requires PostgreSQL metadata and Redis.
# DATA_AGENT_JOB_QUEUE_BACKEND=thread
# DATA_AGENT_REDIS_URL=redis://localhost:6379/0
# DATA_AGENT_ARQ_QUEUE=data-agent
# DATA_AGENT_ARQ_MAX_JOBS=2
# DATA_AGENT_ARQ_JOB_TIMEOUT=3600
# DATA_AGENT_ARQ_MAX_TRIES=3
# PostgreSQL outbox replay interval while a message is still pending.
# DATA_AGENT_OUTBOX_INTERVAL_SECONDS=30

# Conditional clarification (P1): ON by default. A job pauses at
# needs_clarification and asks the next unresolved TaskSpec slot. Each answer is
# folded back into the goal and creates one new frozen plan version; it never
# directly mutates data. Goals without missing slots run straight through.
# Opt out with DATA_AGENT_CLARIFY_ENABLED=0.
# DATA_AGENT_CLARIFY_ENABLED=1

# Maximum clarification rounds per task session (1-10, default 3). If unresolved
# slots remain at the limit, the job moves to plan confirmation with assumptions.
# DATA_AGENT_MAX_CLARIFICATION_ROUNDS=3

# Pre-execution confirmation for answer-mode tasks. High-risk filter/dedup steps
# always require confirmation; enabling this flag makes every answer-mode task
# pause after planning. discover/plan modes never execute data operations.
# DATA_AGENT_CONFIRM_ENABLED=0

# uvicorn HTTP worker processes. thread/file mode requires exactly one. PostgreSQL +
# ARQ mode supports multiple API workers because they do not execute jobs themselves.
# DATA_AGENT_API_WORKERS=1

# Proxy IPs trusted by uvicorn when parsing X-Forwarded-For. Defaults to localhost.
# Compose sets "*" only inside its isolated backend network, where nginx overwrites
# client-supplied forwarding headers.
# DATA_AGENT_FORWARDED_ALLOW_IPS=127.0.0.1

# Delete job directories older than this many seconds on startup (0 disables).
# Default is 7 days.
# DATA_AGENT_JOB_TTL_SECONDS=604800

# Per-file upload size cap in bytes (default 100 MB). Keep nginx
# client_max_body_size >= this value.
# DATA_AGENT_MAX_UPLOAD_BYTES=104857600

# Maximum number of files accepted in a single upload (default 50).
# DATA_AGENT_MAX_UPLOAD_FILES=50

# Aggregate upload and per-tenant admission quotas. Zero disables a quota. The
# production compose topology enables active-job limits and a bounded tmpfs.
# DATA_AGENT_MAX_BATCH_UPLOAD_BYTES=524288000
# DATA_AGENT_MAX_ACTIVE_JOBS_PER_TENANT=4
# DATA_AGENT_MAX_STORED_BYTES_PER_TENANT=0
# DATA_AGENT_MIN_FREE_TEMP_BYTES=268435456

# Where async job directories are written (default <repo>/data/api_jobs).
# DATA_AGENT_API_WORK_DIR=

# Task metadata backend. Local development defaults to file. The production compose
# topology sets postgres; S3 mode keeps only a disposable execution cache in
# DATA_AGENT_API_WORK_DIR.
# DATA_AGENT_METADATA_BACKEND=file
# DATA_AGENT_DATABASE_URL=postgresql://data_agent:password@localhost:5432/data_agent
# DATA_AGENT_DATABASE_POOL_SIZE=10
# Copy valid legacy JSON metadata into an empty PostgreSQL repository on startup.
# Existing database documents always win and source files are never deleted.
# DATA_AGENT_METADATA_AUTO_MIGRATE=1

# Artifact backend. Production compose uses S3-compatible MinIO; local development
# keeps uploads and results in DATA_AGENT_API_WORK_DIR.
# DATA_AGENT_ARTIFACT_BACKEND=local
# DATA_AGENT_ARTIFACT_BUCKET=data-agent-artifacts
# DATA_AGENT_ARTIFACT_PREFIX=jobs
# DATA_AGENT_S3_ENDPOINT_URL=http://localhost:9000
# DATA_AGENT_S3_REGION=us-east-1
# DATA_AGENT_S3_ACCESS_KEY=data-agent
# DATA_AGENT_S3_SECRET_KEY=

# Required by docker-compose's PostgreSQL service. Use a strong random value.
DATA_AGENT_DATABASE_PASSWORD=replace-with-a-long-random-database-password
# Required by docker-compose's MinIO service. Use a different strong random value.
DATA_AGENT_ARTIFACT_SECRET=replace-with-another-long-random-artifact-password

# CSV files at or above this size use the DuckDB-accelerated reader
# (default 5000000 bytes); parsing falls back to pandas on any DuckDB issue.
# DATA_AGENT_DUCKDB_CSV_MIN_BYTES=5000000
# DataFrame operations at or above this row count use semantics-safe DuckDB filter,
# aggregate and deterministic lookup pushdown. Unsupported/business-number cases
# stay on pandas.
# DATA_AGENT_DUCKDB_MIN_ROWS=100000

# How many parsed table sets stay in the in-process read cache (default 8).
# DATA_AGENT_TABLE_CACHE_ENTRIES=8

# Log level for the structured API logs (DEBUG/INFO/WARNING/ERROR).
# DATA_AGENT_LOG_LEVEL=INFO

# Host port the web console is published on by docker-compose (container is :80).
# WEB_PORT=8080
