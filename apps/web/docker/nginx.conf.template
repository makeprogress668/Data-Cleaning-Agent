# nginx serves the built SPA and reverse-proxies the API to the backend service.
# ${BACKEND_HOST}/${BACKEND_PORT} are substituted from env at container start
# (nginx:alpine runs envsubst on files in /etc/nginx/templates automatically).
# Resolve through Docker DNS at request time. A static upstream keeps the old
# container IP after only the backend is recreated and makes a healthy-looking web
# container return 502 until nginx is restarted.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;
    set $backend_origin "http://${BACKEND_HOST}:${BACKEND_PORT}";

    # Allow large spreadsheet uploads; keep in sync with DATA_AGENT_MAX_UPLOAD_BYTES.
    client_max_body_size 128m;

    root /usr/share/nginx/html;
    index index.html;

    # Static assets are content-hashed by Vite, so they can be cached aggressively.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Reverse-proxy the API. Long-running uploads/processing need generous timeouts.
    location /api/ {
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${DATA_AGENT_API_KEY}";
        # An OIDC-aware gateway may authenticate the browser session and inject a
        # Bearer token. Preserve it; the backend still validates every JWT itself.
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    # Health endpoint passthrough for external probes.
    location = /health {
        proxy_pass $backend_origin/health;
    }

    # SPA fallback: every other path serves index.html so client routing works.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
