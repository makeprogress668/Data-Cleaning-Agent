.venv/
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
apps/web/.env
.DS_Store
~$*
.vscode/
.idea/
.codex-tmp/
.tmp/

# Local Trae IDE state, planning transcripts and personal skills are not product
# source or release documentation.
.trae/
*.egg-info/
dist/
build/
node_modules/
apps/web/dist/
apps/web/node_modules/
*.tsbuildinfo

# Project-local interpreter used to keep the mandated backend venv reproducible.
.tools/

data/input/*
data/output/*
data/demo/*
data/api_jobs/*
data/evaluation/*
# Acceptance fixtures are regenerated by scripts/make_acceptance_data.py, and the
# real ones you swap in are your business data — neither belongs in the repo.
data/acceptance/*
data/acceptance_runs/*
!data/input/.gitkeep
!data/output/.gitkeep
!data/demo/.gitkeep
!data/api_jobs/.gitkeep

# Machine-local agent state. Both hold what this installation was asked to do —
# goal text, table and column names — so they belong to the operator, not the repo.
# Globbed rather than anchored: these resolve under backend/data/, not the repo root.
**/data/understanding_cache.json
**/data/user_memory.json
backend/data/
